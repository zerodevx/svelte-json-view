{
  "name": "@zerodevx/svelte-json-view",
  "version": "2.0.1",
  "description": "View JSON data prettily",
  "author": "Jason Lee <jason@zerodevx.com>",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prepack && vite build -c vite-bundled.config.js && npx publint",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --check . && eslint && npm run check",
    "format": "prettier --write .",
    "test:e2e": "playwright install && playwright test",
    "test": "npm run lint && npm run test:e2e"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents": true
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./bundled.js": {
      "types": "./dist/bundled.svelte.d.ts",
      "default": "./dist/bundled.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/bundled.js",
  "license": "ISC",
  "repository": "github:zerodevx/svelte-json-view",
  "keywords": [
    "svelte",
    "vanillajs",
    "json-pretty-print",
    "json-tree"
  ]
}
